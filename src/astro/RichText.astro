---
import BlockShell from "./BlockShell.astro";
import { parseRichText } from "../render";
import type { PublicBlock } from "../public";
interface Props { block: PublicBlock }
const { block } = Astro.props;
const paragraphs = parseRichText(block.props.body ?? "");
---
<BlockShell block={block} class="sb-richtext" label="Site message">
	{paragraphs.map((parts) => (
		<p>{parts.map((p) => ("br" in p ? <br /> : p.href ? <a href={p.href}>{p.text}</a> : p.text))}</p>
	))}
</BlockShell>
